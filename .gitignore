## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Environment files
.env

# AG specific cache
.agc-cache/

# Working notes (per file header)
plan.md

# vscode settings
.vscode/
vscode-agentic/

# Python cache (test/script byproducts)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ML artefacts — regenerated locally from train/dataset/ + scripts.
# See docs/training.md "Reproducing the artefacts" for how to rebuild.
train/lora_adapter_*/
train/agc_tokenizer/
train/mlx_chat/

# Derived training data (regenerated by augment_no_tests.py via run_l3.py).
# The *_dual variants are augmentations of the *source* pair files and can
# be rebuilt deterministically. Source corpora (agc_pairs_{claude,naming,
# hard,capability,pro,self,v4_flash,v5hq_combined,v2_verbose}.jsonl) stay
# tracked — they took real Claude subagent / Gemini API compute to author.
train/dataset/*_dual.jsonl
train/dataset/agc_pairs_v13_source.jsonl

# Patched bases (4 GB each, regenerated by L7 scripts)
.cache/agc/
# More derived files
train/dataset/agc_corpus.txt
